#!/bin/bash
#PBS -N bench_compute
#PBS -q gpu-test
#PBS -l nodes=1:ppn=40
#PBS -l walltime=02:00:00
#PBS -l mem=60gb
#PBS -o bench_compute.out
#PBS -e bench_compute.err
#PBS -V

cd $PBS_O_WORKDIR
module load compilers/cuda/11.1
~/.conda/envs/learn_reg/bin/python -c "import torch; assert torch.cuda.is_available(), 'CUDA not visible - env/module mismatch (Change.MD item 25)'" || exit 1

echo "==== Compute benchmark started at $(date) on $(hostname) ===="
nvidia-smi || echo "no GPU visible"

~/.conda/envs/learn_reg/bin/python benchmark_compute.py

echo "==== Job ended at $(date) ===="
