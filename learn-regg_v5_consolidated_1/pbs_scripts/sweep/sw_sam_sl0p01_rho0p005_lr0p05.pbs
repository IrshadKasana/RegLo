#!/bin/bash
#==========================
# PBS Configuration
#==========================
#PBS -N swsams01r005l05
#PBS -q gpu-ext
#PBS -l select=1:ncpus=8:mem=60gb
#PBS -l walltime=24:00:00
#PBS -o logs/sw_sam_sl0p01_rho0p005_lr0p05.out
#PBS -e logs/sw_sam_sl0p01_rho0p005_lr0p05.err
#PBS -V

#==========================
# Enter Project Directory
#==========================
cd "$PBS_O_WORKDIR"
mkdir -p logs

#==========================
# Environment
#==========================
module purge
module load compilers/cuda/11.1
export PYTHONUNBUFFERED=1
PY="$HOME/.conda/envs/learn_reg/bin/python"

#==========================
# GPU Validation
#==========================
echo "========================================"
echo "Sweep Cell  : sw_sam_sl0p01_rho0p005_lr0p05"
echo "Job Started : $(date)"
echo "Host        : $(hostname)"
echo "Directory   : $PWD"
echo "========================================"
nvidia-smi || echo "WARNING : nvidia-smi not found"

$PY - <<'PYCHECK'
import torch
print("Torch :", torch.__version__)
print("CUDA  :", torch.version.cuda)
print("Available :", torch.cuda.is_available())
assert torch.cuda.is_available(), "CUDA not visible - torch/CUDA module mismatch. Fix the env on the LOGIN node before resubmitting."
print("GPU :", torch.cuda.get_device_name(0))
print("Device Count :", torch.cuda.device_count())
PYCHECK
if [ $? -ne 0 ]; then
    echo "GPU validation FAILED - aborting before walltime is consumed."
    exit 1
fi

#==========================
# Run Sweep Cell (meta-train -> evaluate)
#==========================
"$PY" experiments/dmo/train.py --regularizer sam --profile production --set dataset=mnist optimizee_model_name=mlp model_name=SWEEP_sw_sam_sl0p01_rho0p005_lr0p05_mnist_mlp smooth_lamb=0.01 if_smooth=True rho=0.005 max_hours=23.0 resume=True lambda_reg=0.05 reg_mode=penalty rho=0.005 \
  && "$PY" experiments/dmo/evaluate_optimizee.py --saved_model SWEEP_sw_sam_sl0p01_rho0p005_lr0p05_mnist_mlp --dataset mnist --optimizee_model mlp --eval_tag sw_sam_sl0p01_rho0p005_lr0p05 --lo_train_dataset mnist --profile production
rc=$?

#==========================
# Exit
#==========================
echo "========================================"
echo "Finished    : $(date)"
echo "Return Code : $rc"
echo "========================================"
echo "NOTE: if the log ends with WALLTIME_EXIT, qsub this SAME script again."
echo "      When ALL cells are done: python pick_best_lambdas.py --apply"
exit $rc
