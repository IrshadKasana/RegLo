#!/bin/bash
#PBS -N eval_sam
#PBS -q gpu-test
#PBS -l nodes=1:ppn=40
#PBS -l walltime=12:00:00
#PBS -l mem=60gb
#PBS -o eval_sam.out
#PBS -e eval_sam.err
#PBS -V

cd $PBS_O_WORKDIR

module load compilers/cuda/11.1
~/.conda/envs/learn_reg/bin/python -c "import torch; assert torch.cuda.is_available(), 'CUDA not visible - env/module mismatch (Change.MD item 25)'" || exit 1

echo "==== Job started at $(date) on $(hostname) ===="
nvidia-smi || echo "no GPU visible"

~/.conda/envs/learn_reg/bin/python experiments/dmo/evaluate_optimizee.py \
    --dataset=mnist --optimizee_model=mlp --saved_model=AdSAM_sgd_LO_140424

echo "==== Job ended at $(date) ===="
# --- production settings (uncomment at deploy; Change.MD item 79) ---
#    --set n_training=10 optimizee_epochs=1000 patience=100 calc_hessian=True hyper_eps=True allow_cpu=False
