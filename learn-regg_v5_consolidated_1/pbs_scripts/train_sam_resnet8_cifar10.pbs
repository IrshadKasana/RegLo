#!/bin/bash
#PBS -N tr_sam_r8_c10
#PBS -q gpu-ext
#PBS -l nodes=1:ppn=40
#PBS -l walltime=48:00:00
#PBS -l mem=60gb
#PBS -o train_sam_resnet8_cifar10.out
#PBS -e train_sam_resnet8_cifar10.err
#PBS -V

cd $PBS_O_WORKDIR
module load compilers/cuda/11.1
~/.conda/envs/learn_reg/bin/python -c "import torch; assert torch.cuda.is_available(), 'CUDA not visible - env/module mismatch (Change.MD item 25)'" || exit 1

echo "==== Meta-train SAM-LO on resnet8/cifar10 started at $(date) on $(hostname) ===="
nvidia-smi || echo "no GPU visible"

# Meta-train the SAM-regularized LO on the ResNet-8 PROXY (78K params -
# BPTT through ResNet-18 itself is not feasible). The resulting checkpoint
# is then meta-tested on resnet18/vgg16 via eval_resnet18_cifar10.pbs.
~/.conda/envs/learn_reg/bin/python experiments/dmo/train.py \
    --regularizer sam \
    --set dataset=cifar10 \
          optimizee_model_name=resnet8 \
          model_name=SAM_LO_resnet8_cifar10 \
          if_pretrained=False \
          pretrained_model_name=no_name \
          smooth_lamb=1.0 if_smooth=True rho=0.05

echo "==== Job ended at $(date) ===="
