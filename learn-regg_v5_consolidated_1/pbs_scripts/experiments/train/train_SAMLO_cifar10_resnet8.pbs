#!/bin/bash
#==========================
# PBS Configuration
#==========================
#PBS -N t_SAMc10_r8
#PBS -q gpu-ext
#PBS -l select=1:ncpus=8:mem=60gb
#PBS -l walltime=24:00:00
#PBS -o logs/train_SAMLO_cifar10_resnet8.out
#PBS -e logs/train_SAMLO_cifar10_resnet8.err
#PBS -V

#==========================
# Enter Project Directory
#==========================
cd "$PBS_O_WORKDIR"
mkdir -p logs

#==========================
# Environment
#==========================
module purge
module load compilers/cuda/11.1
export PYTHONUNBUFFERED=1
PY="$HOME/.conda/envs/learn_reg/bin/python"

#==========================
# GPU Validation
#==========================
echo "========================================"
echo "Job Started : $(date)"
echo "Job Name    : train_SAMLO_cifar10_resnet8"
echo "Host        : $(hostname)"
echo "Directory   : $PWD"
echo "========================================"
nvidia-smi || echo "WARNING : nvidia-smi not found"

$PY - <<'PYCHECK'
import torch
print("Torch :", torch.__version__)
print("CUDA  :", torch.version.cuda)
print("Available :", torch.cuda.is_available())
assert torch.cuda.is_available(), "CUDA not visible - torch/CUDA module mismatch. Fix the env on the LOGIN node before resubmitting."
print("GPU :", torch.cuda.get_device_name(0))
print("Device Count :", torch.cuda.device_count())
PYCHECK
if [ $? -ne 0 ]; then
    echo "GPU validation FAILED - aborting before walltime is consumed."
    exit 1
fi

#==========================
# Run Experiment
#==========================
"$PY" experiments/dmo/train.py --regularizer sam_cifar10_r8 --profile production --set model_name=SAMLO_cifar10_resnet8 dataset=cifar10 optimizee_model_name=resnet8 max_hours=23.0
rc=$?

#==========================
# Exit
#==========================
echo "========================================"
echo "Finished    : $(date)"
echo "Return Code : $rc"
echo "========================================"
echo "NOTE: if the log ends with WALLTIME_EXIT, just qsub this SAME script"
echo "      again — training resumes from the last epoch-block and"
echo "      evaluation from the last completed instance."
exit $rc
