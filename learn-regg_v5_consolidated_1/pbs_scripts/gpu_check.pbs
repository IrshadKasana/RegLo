#!/bin/bash
#PBS -N gpu_check
#PBS -q gpu-test
#PBS -l nodes=1:ppn=4
#PBS -l walltime=00:05:00
#PBS -o gpu_check.out
#PBS -e gpu_check.err
#PBS -V
cd $PBS_O_WORKDIR
nvidia-smi
echo "==== GPU details ===="
nvidia-smi --query-gpu=name,memory.total,compute_cap --format=csv
~/.conda/envs/learn_reg/bin/python -c "import torch; print('CUDA:', torch.cuda.is_available()); print('GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'none'); print('VRAM GB:', torch.cuda.get_device_properties(0).total_memory/1e9 if torch.cuda.is_available() else 0)"
