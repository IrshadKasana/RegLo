#!/bin/bash
#==========================
# PBS Configuration  (Agastya, PBS Pro)
#==========================
#PBS -N c4lane0
#PBS -q gpu-ext
#PBS -l select=1:ncpus=40:mem=120gb
#PBS -l walltime=24:00:00
#PBS -o logs/lane0.out
#PBS -e logs/lane0.err
#PBS -V

cd "$PBS_O_WORKDIR"
mkdir -p logs

module purge
module load compilers/cuda/11.1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=40
PY="$HOME/.conda/envs/learn_reg/bin/python"

echo "Job lane0 started $(date) on $(hostname)"
nvidia-smi || echo "WARNING : nvidia-smi not found"

cd experiments/convnet4_lambda_sweep_svhn_cifar10
"$PY" run_sweep.py node --lane 0 --lanes 2 --procs 5 --threads 8 --max-hours 23.5 --require-gpu --preset full --datasets svhn cifar10 --regs l1 l2 sam gsam gam --meta-seeds 0 --radius 1
rc=$?
echo "Finished $(date)  rc=$rc"
echo "NOTE: if the log ends with WALLTIME_EXIT, qsub this SAME script again (or use the chain)."
exit $rc
