#!/bin/bash
#SBATCH --job-name=testDMCNN # create a short name for your job
#SBATCH --nodes=1 # node count
#SBATCH --ntasks=1 # total number of tasks across all nodes
#SBATCH --cpus-per-task=4 # cpu-cores per task (>1 if multi-threaded tasks)
#SBATCH --mem-per-cpu=16G # memory per cpu-core (4G per cpu-core is default)
#SBATCH --time=23:59:59 # total run time limit (HH:MM:SS)
#SBATCH --gres=gpu:1 # number of gpus per node
#SBATCH --partition=gpu03
#SBATCH --mail-type=begin # send email when job begins
#SBATCH --mail-type=end # send email when job ends
#SBATCH --mail-user=<YourNetID>@domain.edu

module purge

singularity exec --nv sing_image_suraj.sif python3 /home/surajk/Mtech_project/l2l/test_pys/test_sdm_mnist.py