Bootstrap: docker
From: nvidia/cuda:12.1.0-devel-ubuntu22.04

%post
	apt update -y
	DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends \
		python3 \
		python3-tk \
		python3-pip \
		python3-setuptools 
	rm -rf /var/lib/apt/lists/*
	pip3 install matplotlib==3.7.1 \
			numpy==1.23.5 \
			torch==2.0.1 \
            tensorflow >=1.0 \
            sonnet >=1.0 \
			seaborn==0.12.2 \
			scipy==1.11.2 \
			torchvision==0.15.2 \
			tqdm==4.66.1 \
			joblib==1.3.2 \
			pandas==1.5.3 \
			urllib3==1.26.6 